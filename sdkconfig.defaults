CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# ~3MB app slot — assets + NimBLE need more than single_app_large (1MB)
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=n
CONFIG_PARTITION_TABLE_HUGE_APP=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
# Public identity preferred for HID discoverability
CONFIG_BT_NIMBLE_HS_PVCY=n
CONFIG_BT_NIMBLE_RPA_TIMEOUT=900
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Soft AP + captive HTTP (wifi_manager)
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_MAX_SOCKETS=16

# TFT + WiFi on USB: PHY start can dip below BOD threshold (log: "Brownout detector was triggered")
CONFIG_ESP_BROWNOUT_DET=n
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=8
CONFIG_ESP_PHY_MAX_TX_POWER=8
CONFIG_ESP_PHY_REDUCE_TX_POWER=y
